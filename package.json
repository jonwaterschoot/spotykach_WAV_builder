{
  "name": "spotykach-wav-builder",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:v2:raw": "vite build --base=/spotykach_WAV_builder/v2/ --outDir=.tmp/v2-build",
    "build:versioned": "node scripts/build-versioned-pages.mjs",
    "build:local": "tsc -b && vite build --base=/",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "predeploy:versioned": "npm run build:versioned",
    "deploy:versioned": "gh-pages -d dist"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@types/jszip": "^3.4.0",
    "@types/uuid": "^10.0.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mobile-drag-drop": "^3.0.0-rc.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}